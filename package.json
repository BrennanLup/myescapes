{
  "name": "myescapes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cozy first-person 3D room holding every escape room the crew has done.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsx server/precompress.ts",
    "serve": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/static": "^10.1.7",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "postprocessing": "^6.39.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
