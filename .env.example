# Copy to .env and fill in. Every variable is optional: the app falls back to mock/seed mode.
PORT=3000

# Claude review extraction from voice transcripts (server-side only).
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-opus-5-5

# PostgreSQL. Without it, an in-process Postgres (PGlite) is stored in DATA_DIR/pglite.
DATABASE_URL=

# Google sign-in (Better Auth). Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Public origin for absolute links such as invite URLs (optional).
PUBLIC_URL=

# Server-side voice transcription.
OPENAI_API_KEY=

# Optional: Google Places, only to attach place ids for "Open in Google Maps" links.
GOOGLE_MAPS_API_KEY=

# Daily spending caps (whole numbers; defaults shown).
# CAP_TRANSCRIBE_SECONDS_PER_USER=1200
# CAP_EXTRACT_CALLS_PER_USER=30
# CAP_TRANSCRIBE_SECONDS_GLOBAL=21600
# CAP_EXTRACT_CALLS_GLOBAL=1000

# Where the local database and the signed-out demo's entries live (default .data/ in the repo, gitignored).
DATA_DIR=
