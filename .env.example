# Copy to .env and fill in. Every variable is optional: the app falls back to mock/seed mode.
PORT=3000

# Claude review extraction from voice transcripts (server-side only).
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Sheet storage for reviews. Without these, seed/reviews.json + a local .data/ store are used.
GOOGLE_SHEET_ID=
# Either the raw JSON of a service account key, or a path to the key file.
GOOGLE_SERVICE_ACCOUNT_JSON=
